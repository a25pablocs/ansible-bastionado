# Grupo de máquinas llamado "servers"
# Agrupación de todos los hosts que van a gestionar juntos con ansible
# Definición de los hosts "server1" y "server2"
# ansible_host = IP real de la máquina
# ansible_user = usuario con el que Ansible se conecta por SSH
[servers]
server1 ansible_host=192.168.56.11 ansible_user=servidor1
server2 ansible_host=192.168.56.12 ansible_user=servidor2

# Variables comunes para todos los hosts del grupo [servers]
# Le dices a Ansible qué Python usar en los nodos remotos
# Esto evita problemas de detección automática de versiones
[servers:vars]
ansible_python_interpreter=/usr/bin/python3
